{
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "permissions": {
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/docs/agents/**)",
      "Edit(/docs/workflow/git-workflow.md)",
      "Edit(/.agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/skills-lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-reads.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-pr.ts\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
