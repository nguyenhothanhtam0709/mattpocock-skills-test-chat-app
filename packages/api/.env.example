DATABASE_URL=postgres://chat:chat@localhost:5432/chat
PORT=3000
# The one origin CORS allows (the SPA). Origin only: no path, no trailing slash.
SPA_ORIGIN=http://localhost:5173

# Ed25519 key pair that signs access tokens (PEM, `\n` for newlines). Generate with:
#   openssl genpkey -algorithm ed25519 -out private.pem && openssl pkey -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# Logging. LOG_LEVEL is the fallback for targets without their own level.
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
# json or pretty
LOG_CONSOLE_FORMAT=json
# LOG_CONSOLE_LEVEL=debug
LOG_FILE_ENABLED=false
# LOG_FILE_PATH=logs/api.log
# LOG_FILE_MAX_SIZE=10m
# daily, hourly or milliseconds
# LOG_FILE_FREQUENCY=daily
# LOG_FILE_RETENTION=7
# LOG_FILE_LEVEL=info
# DB_SLOW_QUERY_MS=200

# Default rate limit
# THROTTLE_LIMIT=120
# THROTTLE_TTL_MS=60000
# Local development only: set to true to turn off every rate limit (login, register, search, send and the default)
# THROTTLE_DISABLED=false
