DATABASE_URL=postgres://chat:chat@localhost:5432/chat
PORT=3000
# The one origin CORS allows (the SPA). Origin only: no path, no trailing slash.
SPA_ORIGIN=http://localhost:5173

# Logging. LOG_LEVEL is the fallback for targets without their own level.
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
# json or pretty
LOG_CONSOLE_FORMAT=json
# LOG_CONSOLE_LEVEL=debug
LOG_FILE_ENABLED=false
# LOG_FILE_PATH=logs/api.log
# LOG_FILE_MAX_SIZE=10m
# daily, hourly or milliseconds
# LOG_FILE_FREQUENCY=daily
# LOG_FILE_RETENTION=7
# LOG_FILE_LEVEL=info
# DB_SLOW_QUERY_MS=200

# Default rate limit
# THROTTLE_LIMIT=120
# THROTTLE_TTL_MS=60000
