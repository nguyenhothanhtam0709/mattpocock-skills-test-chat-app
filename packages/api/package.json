{
  "name": "@chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/migrate-cli.js",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/seed-cli.js"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^12.2.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io-msgpack-parser": "^3.0.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
